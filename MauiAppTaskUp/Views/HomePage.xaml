<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppTaskUp.Views.HomePage"
             Title="HomePage">
  
        <Grid RowDefinitions="*, Auto" Padding="30">

            <!-- חלק מרכזי: לוגו, כותרת ותיאור -->
            <VerticalStackLayout Grid.Row="0" 
                             VerticalOptions="Center" 
                             Spacing="20">

                <!-- אייקון / לוגו של האפליקציה -->
                <Image Source="app_logo.png" 
                   HeightRequest="120" 
                   WidthRequest="120" 
                   HorizontalOptions="Center" />

                <!-- כותרת ראשית -->
                <Label Text="Task &amp; Event Manager" 
                   FontSize="28" 
                   FontAttributes="Bold" 
                   TextColor="#1A2530" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />

                <!-- תיאור קצר -->
                <Label Text="נהל את המשימות והאירועים שלך בקלות ובפשטות" 
                   FontSize="16" 
                   TextColor="#6C7A89" 
                   HorizontalOptions="Center" 
                   HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- חלק תחתון: כפתורי התחברות והרשמה -->
            <VerticalStackLayout Grid.Row="1" 
                             Spacing="15" 
                             Margin="0,0,0,20">

                <!-- כפתור מעבר למסך התחברות (מקושר ל-Command) -->
                <Button Text="התחברות" 
                    BackgroundColor="#2A64F6" 
                    TextColor="White" 
                    FontSize="18" 
                    FontAttributes="Bold"
                    CornerRadius="12" 
                    HeightRequest="55" 
                    Command="{Binding LoginCommand}" />

                <!-- כפתור מעבר למסך הרשמה (מקושר ל-Command) -->
                <Button Text="הרשמה" 
                    BackgroundColor="Transparent" 
                    TextColor="#2A64F6" 
                    BorderColor="#2A64F6"
                    BorderWidth="2"
                    FontSize="18" 
                    FontAttributes="Bold"
                    CornerRadius="12" 
                    HeightRequest="55" 
                    Command="{Binding RegisterCommand}" />

            </VerticalStackLayout>

        </Grid>
       
        </ContentPage>